# No entry is needed for the example binaries: `go build ./demo/cmd/client`
# would write "client" into the working directory, where the client package
# directory already occupies that name, so go refuses rather than writing one.
# The same goes for the server. Use `go run`, or `go build -o`.

# Test binaries from `go test -c`.
*.test

# Coverage and profile output.
*.out
*.prof

# A local go.work linking this module to examples/consumer is a convenience,
# not part of the repository: that module carries its own replace directive.
go.work
go.work.sum
